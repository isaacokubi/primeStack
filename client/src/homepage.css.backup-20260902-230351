/* =========================================================
   PRIMEStack — FINAL HOMEPAGE LAYOUT SYSTEM
   Fix section alignment + enlarge founder portrait
   ========================================================= */

/* ---------- GLOBAL HOMEPAGE CONTAINER ---------- */

main > section,
main > article {
  width: min(100% - 48px, 1400px) !important;
  max-width: 1400px !important;
  margin-left: auto !important;
  margin-right: auto !important;
  box-sizing: border-box !important;
}

/* ---------- HERO ---------- */

.hero {
  width: min(100% - 48px, 1400px) !important;
  max-width: 1400px !important;
  margin-left: auto !important;
  margin-right: auto !important;

  display: grid !important;
  grid-template-columns: minmax(0, 1fr) minmax(360px, 430px) !important;
  align-items: center !important;
  gap: 55px !important;

  min-height: 680px !important;
  padding: 70px 0 !important;

  overflow: visible !important;
}

/* Hero text must stay on the left */

.hero > div:first-child {
  width: 100% !important;
  max-width: 760px !important;
  min-width: 0 !important;
  margin: 0 !important;
  text-align: left !important;
}

/* Hero heading */

.hero h1 {
  max-width: 760px !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
}

/* Hero paragraph */

.hero p {
  max-width: 650px !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
}

/* Hero buttons */

.hero .actions {
  justify-content: flex-start !important;
}

/* ---------- FOUNDER PORTRAIT ---------- */

.hero > .mockup {
  position: relative !important;

  width: 100% !important;
  max-width: 430px !important;

  height: 500px !important;
  min-height: 500px !important;

  margin: 0 0 0 auto !important;

  display: flex !important;
  align-items: flex-start !important;
  justify-content: center !important;

  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;

  overflow: visible !important;
}

.hero > .mockup .heroFounderImage {
  position: relative !important;

  display: block !important;

  width: auto !important;
  height: auto !important;

  max-width: 430px !important;
  max-height: 490px !important;

  min-width: 0 !important;
  min-height: 0 !important;

  margin: 0 auto !important;

  object-fit: contain !important;
  object-position: center top !important;

  z-index: 5 !important;
  opacity: 1 !important;
}

/* Remove old mockup decoration */

.hero > .mockup .mockupOverlay,
.hero > .mockup .mockHeader,
.hero > .mockup .mockTitle,
.hero > .mockup .mockgrid {
  display: none !important;
}

/* Founder caption */

.hero > .mockup .founderCaption {
  position: absolute !important;
  left: 50% !important;
  bottom: 5px !important;

  transform: translateX(-50%) !important;

  width: max-content !important;
  max-width: 95% !important;

  text-align: center !important;

  z-index: 10 !important;
}

/* ---------- SECTION HEADERS ---------- */

.sectionHead {
  width: 100% !important;
  max-width: 1400px !important;
  margin-left: auto !important;
  margin-right: auto !important;

  display: flex !important;
  align-items: flex-end !important;
  justify-content: space-between !important;

  gap: 30px !important;

  text-align: left !important;
}

.sectionHead > div {
  min-width: 0 !important;
}

.sectionHead h2 {
  margin-left: 0 !important;
  margin-right: 0 !important;
}

/* ---------- PRODUCTS ---------- */

.grid {
  width: 100% !important;
  max-width: 1400px !important;

  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;

  gap: 20px !important;

  margin-left: auto !important;
  margin-right: auto !important;
}

.grid .card {
  width: 100% !important;
  margin: 0 !important;
  text-align: left !important;
}

/* ---------- SERVICES ---------- */

.serviceGrid {
  width: 100% !important;
  max-width: 1400px !important;

  margin-left: auto !important;
  margin-right: auto !important;

  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;

  gap: 20px !important;
}

.serviceGrid .service {
  width: 100% !important;
  margin: 0 !important;
  text-align: left !important;
}

/* ---------- CASE STUDIES ---------- */

.caseGrid,
.caseStudies,
.casesGrid {
  width: 100% !important;
  max-width: 1400px !important;

  margin-left: auto !important;
  margin-right: auto !important;
}

/* ---------- TESTIMONIALS ---------- */

.testimonials,
.testimonialGrid,
.quotes,
.quoteGrid {
  width: 100% !important;
  max-width: 1400px !important;

  margin-left: auto !important;
  margin-right: auto !important;
}

/* ---------- BLOG ---------- */

.blogGrid,
.postsGrid,
.articleGrid {
  width: 100% !important;
  max-width: 1400px !important;

  margin-left: auto !important;
  margin-right: auto !important;
}

/* ---------- CTA ---------- */

.cta {
  width: 100% !important;
  max-width: 1400px !important;

  margin-left: auto !important;
  margin-right: auto !important;

