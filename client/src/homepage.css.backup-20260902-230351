/* primeStack homepage upgrade */
.hero{position:relative;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(380px,.95fr);align-items:center;gap:48px;min-height:700px;padding-top:72px;padding-bottom:72px;overflow:visible;background:radial-gradient(circle at 82% 38%,rgba(199,243,107,.10),transparent 24%),radial-gradient(circle at 60% 10%,rgba(34,102,170,.18),transparent 30%)}
