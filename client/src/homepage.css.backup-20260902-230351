.sectionHead{align-items:end;margin-bottom:32px}.sectionHead h2{font-size:clamp(2.2rem,4vw,4rem);letter-spacing:-.045em;color:#fff}.sectionHead>a{color:#c7f36b;font-weight:700}.grid{gap:16px}.card{position:relative;border:1px solid #1c2d41;background:linear-gradient(145deg,#0d1a2a,#091522);border-radius:18px;padding:25px;transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease;color:#e8edf5}.card:hover{transform:translateY(-5px);border-color:#38516d;box-shadow:0 20px 45px rgba(0,0,0,.22)}.card h3{font-size:1.35rem;color:#fff}.card p{color:#b8c3d1}.productLogo{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;background:#13243a;color:#c7f36b;margin-bottom:22px}.pill{display:inline-flex;padding:5px 9px;border-radius:99px;background:#102237;color:#c4d0dd;font-size:.67rem;font-weight:800}.learn{display:inline-flex;align-items:center;gap:7px;margin-top:14px;color:#c7f36b;font-size:.82rem;font-weight:800}
.serviceGrid{color:#e8edf5}.serviceGrid .service{color:#e8edf5}.serviceGrid .service h3{color:#fff}.serviceGrid .service p{color:#b8c3d1}.serviceGrid .service>span{color:#c7f36b}.empty{color:#c0cad6!important}.eyebrow{color:#9eafc1}.pageHead h1,.detailHero h1{color:#fff}.pageHead p,.detailHero>p{color:#b8c3d1}
.cta{position:relative;margin-top:40px;margin-bottom:20px;border:1px solid #293e54;border-radius:28px;overflow:hidden;background:radial-gradient(circle at 90% 30%,rgba(199,243,107,.13),transparent 25%),linear-gradient(135deg,#0d1d2f,#08131f);box-shadow:0 25px 70px rgba(0,0,0,.25)}.cta::after{content:'';position:absolute;width:220px;height:220px;right:-80px;bottom:-110px;border:1px solid rgba(199,243,107,.14);border-radius:50%}.cta h2{position:relative;z-index:1;font-size:clamp(2.4rem,5vw,4.7rem);max-width:800px;letter-spacing:-.05em;color:#fff}.cta p{position:relative;z-index:1;max-width:700px;color:#b8c3d1;font-size:1.05rem}.cta .btn{position:relative;z-index:2}.newsletter{border:1px solid #1e3044!important;background:linear-gradient(135deg,#0c1a2a,#091522)!important;border-radius:22px!important;padding:32px!important;box-shadow:0 20px 55px rgba(0,0,0,.20)}.newsletter h3{font-size:1.65rem;margin:8px 0 3px;color:#fff}.newsletter p{color:#b8c3d1;margin:0}.newsletter form{border:1px solid #273a50;background:#07111e;border-radius:12px;padding:6px 6px 6px 14px}.newsletter input{min-width:0;color:#fff}.navLogin{color:#d7e0ea!important;font-weight:700}.navLogin:hover{color:#fff!important}
.mockup .founderCaption{position:absolute!important;left:20px!important;right:20px!important;bottom:20px!important;display:flex!important;flex-direction:column!important;gap:4px!important;max-width:calc(100% - 40px)!important;padding:12px 14px!important;border-radius:12px!important;background:rgba(7,16,29,.9)!important;backdrop-filter:blur(6px)!important;-webkit-backdrop-filter:blur(6px)!important;color:#fff!important;z-index:5!important}.mockup .founderCaption>span{color:#c7f36b!important;font-size:.64rem!important;font-weight:800!important;letter-spacing:.16em!important}.mockup .founderCaption strong{font-size:1.35rem!important;line-height:1.1!important;font-weight:800!important;color:#fff!important;overflow-wrap:anywhere}.mockup .founderCaption em{font-size:.82rem!important;line-height:1.25!important;font-style:normal!important;font-weight:600!important;color:#c4d0dd!important;opacity:1!important;overflow-wrap:anywhere}
