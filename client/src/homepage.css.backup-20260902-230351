.heroTrust{display:flex;flex-wrap:wrap;gap:10px 24px;margin-top:30px}.heroTrust span{color:#c5d0dc!important;font-size:.78rem;font-weight:700}.heroTrust span::before{content:'✓';color:#c7f36b;margin-right:7px}
.mockup{position:relative;min-height:560px;height:560px;width:100%;border-radius:34px;border:1px solid rgba(255,255,255,.12);overflow:hidden;isolation:isolate;background:#0a1624;box-shadow:0 35px 100px rgba(0,0,0,.42),0 0 80px rgba(26,91,145,.12);transform:rotate(1.5deg);z-index:1}
